NODE_ENV=development
PORT=5000
NODE_VERSION=24.14.1

CORS_ORIGINS=http://localhost:5173,http://localhost:3000
CORS_CREDENTIALS=false
FRONTEND_URL=http://localhost:3000

JSON_BODY_LIMIT=1mb

DNS_SERVERS=1.1.1.1,8.8.8.8

MONGO_DB_CONNECTION_STRING=mongodb+srv://usuario:senha@cluster.mongodb.net
MONGO_DB_DATABASE_NAME=aplicacao_nutricional_dev

# =========================
# RETENCAO DE ARQUIVADOS
# =========================
# Defaults usados quando as variaveis nao forem informadas:
# nutricionista=30 dias, paciente=365 dias, plano alimentar=365 dias.
NUTRICIONISTA_ARCHIVE_RETENTION_DAYS=30
PACIENTE_ARCHIVE_RETENTION_DAYS=365
PLANO_ALIMENTAR_ARCHIVE_RETENTION_DAYS=365

# =========================
# AUTENTICACAO
# =========================
JWT_SECRET=your-dev-jwt-secret
JWT_REFRESH_SECRET=your-dev-jwt-refresh-secret
ACCESS_TOKEN_EXPIRES_IN=15m
REFRESH_TOKEN_EXPIRES_IN=7d
JWT_EXPIRES_IN=1d

# =========================
# CONFIRMACAO DE E-MAIL
# =========================
EMAIL_USER=
# Senha de app do Google com 16 caracteres. Nunca use a senha principal.
EMAIL_APP_PASSWORD=

# =========================
# CRIPTOGRAFIA
# =========================
ENCRYPTION_KEY=your-dev-encryption-key
SEARCH_HASH_KEY=your-dev-search-hash-key

# Fingerprints SHA-256 das chaves de producao. Nao sao chaves nem secrets.
# Preencha no ambiente local para impedir reutilizacao acidental de uma chave de producao.
PROD_ENCRYPTION_KEY_FINGERPRINT=
PROD_SEARCH_HASH_KEY_FINGERPRINT=
PROD_JWT_SECRET_FINGERPRINT=
PROD_JWT_REFRESH_SECRET_FINGERPRINT=

REDIS_URL=redis://localhost:6379

CLOUDINARY_API_ENVIROMENT=
CLOUDINARY_API_KEY=
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_SECRET=
