NODE_ENV=development
PORT=5000
NODE_VERSION=24.14.1

# Use uma lista separada por virgulas. No Render, coloque o dominio publico do front-end.
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
CORS_CREDENTIALS=false
FRONTEND_URL=

JSON_BODY_LIMIT=1mb

# Local/Atlas/Render. Se a URL ja incluir o banco, MONGO_DB_DATABASE_NAME pode ficar vazio.
MONGO_DB_CONNECTION_STRING=mongodb+srv://usuario:senha@cluster.mongodb.net
MONGO_DB_DATABASE_NAME=nutri-plan

JWT_SECRET=troque-por-uma-chave-grande-e-segura
JWT_EXPIRES_IN=1d
